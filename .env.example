# Classic PAT or fine-grained token. Never commit a real token.
GITHUB_TOKEN=
GITHUB_ORG=

# Optional GitHub App, required for app webhook deliveries.
# The installation id is used for the organization scan when no PAT is set.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

PORT=8787
HOST=0.0.0.0
